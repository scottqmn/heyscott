# Copy to .env.local and fill in once the Prismic repository exists.
#
# The public repository name. Overrides `repositoryName` in
# slicemachine.config.json (currently the placeholder "heyscott").
NEXT_PUBLIC_PRISMIC_ENVIRONMENT=

# Access token — only required if the Prismic repo is private / has restricted
# API access. Leave blank for public repositories.
PRISMIC_ACCESS_TOKEN=
